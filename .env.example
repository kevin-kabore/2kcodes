# Database Configuration
# Prisma reads POSTGRES_PRISMA_URL (pooled, runtime) and POSTGRES_URL_NON_POOLING
# (direct, migrations). On Vercel these are provided automatically by the
# Supabase integration. For local dev, point both at your local Postgres.
POSTGRES_PRISMA_URL="postgresql://username:password@localhost:5432/2kcodes?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://username:password@localhost:5432/2kcodes?schema=public"

# Authentication Configuration
# Dynamic Labs configuration - Required for authentication
# Get your environment ID from https://app.dynamic.xyz
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID="your-dynamic-environment-id"