# Database Configuration
# PostgreSQL connection string - Required for full features
# For local development: postgresql://username:password@localhost:5432/2kcodes
# For production (Supabase): use the pooled connection string (port 6543, pgbouncer=true)
DATABASE_URL="postgresql://username:password@localhost:5432/2kcodes"

# Authentication Configuration
# Dynamic Labs configuration - Required for authentication
# Get your environment ID from https://app.dynamic.xyz
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID="your-dynamic-environment-id"